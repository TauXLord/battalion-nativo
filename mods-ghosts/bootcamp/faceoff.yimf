  <script>
    <event>
      <condition type="startGame" />
	  <response type="disableMorale"><disable value="true" /></response>
      <response type="disableAllUnits">
        <disable value="true" />
        <controller value="0" />
      </response>
      <response type="enableUnit">
        <enable value="true" />
        <controller value="0" />
        <unit value="Strike Commando" />
      </response>
      <response type="enableUnit">
        <enable value="true" />
        <controller value="0" />
        <unit value="Heavy Commando" />
      </response>
      <response type="enableUnit">
        <enable value="true" />
        <controller value="0" />
        <unit value="Flak Tank" />
      </response>
      <response type="enableUnit">
        <enable value="true" />
        <controller value="0" />
        <unit value="Scorpion Tank" />
      </response>
      <response type="enableUnit">
        <enable value="true" />
        <controller value="0" />
        <unit value="Mortar Truck" />
      </response>
      <response type="enableUnit">
        <enable value="true" />
        <controller value="0" />
        <unit value="Annihilator Tank" />
      </response>
      <response type="enableUnit">
        <enable value="true" />
        <controller value="0" />
        <unit value="Rocket Truck" />
      </response>
      <response type="disableControllers">
        <disable value="true" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="It is time to put your tactical skills to the test. Good luck soldier, make us proud!" />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="disableControllers">
        <disable value="False" />
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1" />
        <victory value="false" />
      </condition>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Your enemy is commanding a force of approximately the same tactical strength so you have to utilize terrain cover and choke points to defeat your opponent." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="We'll get everything set up for when you're ready to tackle this scenario again." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1" />
        <victory value="true" />
      </condition>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Congratulations! You have completed your boot camp training. Head back to headquarters and prepare for departure to the front lines." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
    </event>
  </script>
</map>