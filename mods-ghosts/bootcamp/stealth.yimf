  <script>
    <event>
      <condition type="startGame" />
	  <response type="disableMorale"><disable value="true" /></response>
      <response type="disableControllers">
        <disable value="true" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Mastery of stealth and counter-stealth tactics is an essential battlefield tactic." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="In this scenario you get to experience both sides of stealth encounters. Being the hunters and being the hunted." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="highlight">
        <x value="8" />
        <y value="0" />
        <show value="true" />
      </response>
      <response type="highlight">
        <x value="8" />
        <y value="1" />
        <show value="true" />
      </response>
      <response type="highlight">
        <x value="6" />
        <y value="2" />
        <show value="true" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="You'll be hunting with these Scorpion Tanks. There are two enemy Stealth Tanks in their vicinity." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="highlight">
        <x value="8" />
        <y value="0" />
        <show value="false" />
      </response>
      <response type="highlight">
        <x value="8" />
        <y value="1" />
        <show value="false" />
      </response>
      <response type="highlight">
        <x value="6" />
        <y value="2" />
        <show value="false" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="A Stealth Tank in waiting will cancel the move of any enemy unit that tries to travel through it and that unit will lose the rest of its turn." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="So your best tactic when hunting Stealth Tanks is to expose it with your first unit, then strike it with your back up." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="highlight">
        <x value="2" />
        <y value="0" />
        <show value="true" />
      </response>
      <response type="highlight">
        <x value="0" />
        <y value="2" />
        <show value="true" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="You'll be hunting the enemy Flaks with these two Stealth Tanks." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="highlight">
        <x value="2" />
        <y value="0" />
        <show value="false" />
      </response>
      <response type="highlight">
        <x value="0" />
        <y value="2" />
        <show value="false" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="When hunting with Stealth Tanks, remember that you do double damage if you strike the target while you are still cloaked." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Ending your turn next to an enemy unit will always decloak your Stealth Tank." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Stealth Tanks have very weak armor, so focus on picking off straggling targets." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Begin the training exercise!" />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="disableControllers">
        <disable value="False" />
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1" />
        <victory value="false" />
      </condition>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="The best way to tackle an invisible enemy is with clusters of troops. Scout ahead to expose the stealth units and then destroy them with the rest of your troops." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Give it another try. I'm sure it'll go better this time." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1" />
        <victory value="true" />
      </condition>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Stealth units like the Stealth Tank and U-Boat can be devastating in the hands of a capable general. On with the next lesson.." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
    </event>
  </script>
</map>