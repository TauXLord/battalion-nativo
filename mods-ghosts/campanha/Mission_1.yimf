  <script>

	
    <event>
      <condition type="startGame" />
	  <response type="disableMorale">
		<disable value="true" />
		</response>
	
      <response type="disableControllers">
        <disable value="true" />
      </response>
	
      <response type="chat">
        <sender value="GENERAL DURAND" />
        <message value="It is a glorious morning, Lieutenant Hayne. Today you begin the conquest of the Northern Federation." />
        <avatar value="evil_durand" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="It is my great honor... and may I say that you could not have picked a more suitable commander for your army." />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>
	
      <response type="chat">
        <sender value="GENERAL DURAND" />
        <message value="Clean up this riff-raff that Captain Tucker left behind. It's embarrassing to even look at their bumbling." />
        <avatar value="evil_durand" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="My battlecruiser and tanks will make short work of them, sir." />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>
	
      <response type="chat">
        <sender value="GENERAL DURAND" />
        <message value="Make me proud, Lieutenant. It took me a great many years to set us up for this assault; I won't see it squandered." />
        <avatar value="evil_durand" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="Squandered? By me? Sir, I am the result of generations of glorious Akadian breeding! There is no one better suited to this task in all of the Akadian people, present company excluded, of course. Now... all units, engage the Federation!" />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>
	
      <response type="disableControllers">
        <disable value="false" />
      </response>
	
    </event>
	
	
    <event>
      <condition type="endGame">
        <player value="1" />
        <victory value="false" />
      </condition>

      <response type="disableControllers">
        <disable value="true" />
      </response>
	
      <response type="chat">
        <sender value="GENERAL DURAND" />
        <message value="Is this a joke? This should have been like using a rocket to swat a fly. You are a disgrace, Hayne." />
        <avatar value="evil_durand" />
        <color value="FF0000FF" />
      </response>
	
      <response type="disableControllers">
        <disable value="false" />
      </response>
	
    </event>	
	
	
    <event>
      <condition type="endGame">
        <player value="1" />
        <victory value="true" />
      </condition>
	
      <response type="disableControllers">
        <disable value="true" />
      </response>
	
	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="This is the best the Federation has?" />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>
	
      <response type="chat">
        <sender value="GENERAL DURAND" />
        <message value="These forces were weak, and Captain Tucker was not there to lead them." />
        <avatar value="evil_durand" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="Tucker will meet the same fate as the rest." />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>

      <response type="chat">
        <sender value="GENERAL DURAND" />
        <message value="You forget, Lieutenant, that I spent a good deal of time in the Federation. For years I was part of Tucker's battalion, and I know his tactics well.  The Northern Federation on the whole is undisciplined... but Tucker is a fierce enemy." />
        <avatar value="evil_durand" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="When I am finished with him, he won't even be able to remember his own name." />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>
	
      <response type="chat">
        <sender value="GENERAL DURAND" />
        <message value="I have a mission for you, Lieutenant. I have gotten word from our advance scouts that the Northern Federation has developed a new type of military base -  a mobile structure." />
        <avatar value="evil_durand" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="I will seek out these units and destroy them, sir. Our engineers will be able to piece together the wreckage to unravel the technology used to craft them. This new weapon will be mine... erm... ours!" />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>

      <response type="chat">
        <sender value="GENERAL DURAND" />
        <message value="One more thing. I will be sending my nephew with you. He needs some time away from me... once and for all..." />
        <avatar value="evil_durand" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="Sir?" />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>

      <response type="chat">
        <sender value="GENERAL DURAND" />
        <message value="To see the world, of course. He needs to get out and see the world." />
        <avatar value="evil_durand" />
        <color value="FF0000FF" />
      </response>
	
      <response type="disableControllers">
        <disable value="false" />
      </response>
	
    </event>
	

  </script>
</map>