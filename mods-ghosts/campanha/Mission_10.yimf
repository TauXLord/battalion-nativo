  <script>
    <event>
      <condition type="endGame">
        <player value="1"/>
        <victory value="false"/>
      </condition>
      <response type="disableControllers">
        <disable value="true"/>
      </response>
      <response type="chat">
        <sender value="MAJOR MAYJOR"/>
        <message value="We were so close. And I hear every time someone fails a mission, a kitten gets punched in the face. Good job with that, Hayne. A kitten got punched because of you."/>
        <avatar value="mayjor"/>
        <color value="FF0000FF"/>
      </response>
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
    <event>
      <condition type="startGame"/>
      <response type="disableMorale">
        <disable value="true"/>
      </response>
      <response type="disableControllers">
        <disable value="true"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="Tucker. This is the end of the line. Your troops have no other locations to run to. No other places to hide. Soon, you will finally have to admit who the superior warrior is."/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN ARGENT"/>
        <message value="I'm sorry, were you looking for Tucker here? No one here but us Dragoons. And me."/>
        <avatar value="argent"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="Don't lie to me. This is one of Tucker's tricks. Come out and fight me!"/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="GENERAL USUL"/>
        <message value="Today we will see how you fare against me."/>
        <avatar value="usul"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="Is he too much of a coward? Fine. All units, attack!"/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1"/>
        <victory value="true"/>
      </condition>
      <response type="disableControllers">
        <disable value="true"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="Victory! The Dragoons are no match for the power of Hayne! I am unstoppable! Crawl away, Captain Argent and tell that coward Tucker that I've crushed the best he had to offer me."/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="MAJOR MAYJOR"/>
        <message value="There's a radio transmission coming through!"/>
        <avatar value="mayjor"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="The General. He won't be able to punish us after he hears of our triumph here today."/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="Hayne! Our forces are under attack! It was a trap, you idiot."/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="MAJOR MAYJOR"/>
        <message value="Told you so."/>
        <avatar value="mayjor"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="What are you talking about? I've destroyed their forces. Their base is in ruins around me. Akadia reigns supreme!"/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="They've been baiting you! They lured you as far away from my forces as they could and then they sprang their trap. Tucker has us surrounded on all sides! I'm ordering a full retreat to Akadia!"/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="But... but... I won! I beat them!"/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="You've doomed us, Hayne! They split our forces. We're outmaneuvered and outgunned now!"/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN ARGENT"/>
        <message value="I think you were saying something funny about my crawling away in defeat?"/>
        <avatar value="argent"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="You! You'll pay for this you smart-mouthed weasel!"/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN ARGENT"/>
        <message value="Sticks and stones, sticks and stones."/>
        <avatar value="argent"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="MAJOR MAYJOR"/>
        <message value="We have to get back and save Uncle!"/>
        <avatar value="mayjor"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="We will return to Akadia to defend her from our enemies... as soon as I destroy this little weakling."/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN ARGENT"/>
        <message value="Let's do this!"/>
        <avatar value="argent"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="GENERAL USUL"/>
        <message value="Keep the Lieutenant occupied, Captain Argent. Dragoons! We rally to join Captain Tucker's forces in assaulting Akadia! The time of our vengeance is at hand!"/>
        <avatar value="usul"/>
        <color value="FF00FF00"/>
      </response>
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
	
