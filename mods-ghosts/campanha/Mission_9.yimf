      <response type="disableControllers">
        <disable value="true"/>
      </response>
      <response type="chat">
        <sender value="MAJOR MAYJOR"/>
        <message value="Hmm. So I'm supposed to follow Hayne's example? Maybe Uncle wants me to go crazy and disobey orders, leading to my eventual defeat as well..."/>
        <avatar value="mayjor"/>
        <color value="FF0000FF"/>
      </response>
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
    <event>
      <condition type="startGame"/>
      <response type="disableMorale">
        <disable value="true"/>
      </response>
      <response type="disableControllers">
        <disable value="true"/>
      </response>
      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="Lieutenant Hayne! What is the meaning of this?"/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="I am completing my mission, sir."/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="Your mission is complete. Your orders were to return to rejoin my forces."/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="I have unfinished business here. Captain Tucker and the Dragoons remain a threat."/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="A threat I will deal with! And that is why your orders are to return to base immediately!"/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="I'm sorry, General. Your transmission is breaking up."/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="I'll have you drummed out for this, Hayne! This is treas..."/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="MAJOR MAYJOR"/>
        <message value="You hung up on him!"/>
        <avatar value="mayjor"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="Not another word from you, Major. Prepare the troops."/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="MAJOR MAYJOR"/>
        <message value="I know they help us move through the mountains... but the Spider Tanks have always creeped me out. I mean, are they poisonous, too? No one will tell me."/>
        <avatar value="mayjor"/>
        <color value="FF0000FF"/>
      </response>
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1"/>
        <victory value="true"/>
      </condition>
      <response type="disableControllers">
        <disable value="true"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN ARGENT"/>
        <message value="Did you see him? He's like a crazy animal out there."/>
        <avatar value="argent"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="GENERAL USUL"/>
        <message value="I saw."/>
        <avatar value="usul"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN ARGENT"/>
        <message value="Are you sure this is still a good idea?"/>
        <avatar value="argent"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="GENERAL USUL"/>
        <message value="Captain Tucker has a sound plan. He has studied his enemy. It will succeed."/>
        <avatar value="usul"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN ARGENT"/>
        <message value="Why am I always the bait?"/>
        <avatar value="argent"/>
        <color value="FFFF0000"/>
      </response>
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
    <event>
      <condition type="startGame"/>
      <response type="disableAllUnits">
        <disable value="true"/>
        <player value="1"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
