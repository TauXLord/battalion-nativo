  <script>
    <event>
      <condition type="killUnit">
        <x value="9"/>
        <y value="6"/>
      </condition>	  
	  	  
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Detonate the charges!"/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
	  
	  <response type="surrenderPlayer"><player value="2" /></response>	  
	  
	  <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="We can't let Hayne get his hands on the Warmachine."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>	  
	  
	</event>
  
    <event>
      <condition type="endGame">
        <player value="1"/>
        <victory value="false"/>
      </condition>
      <response type="disableControllers">
        <disable value="true"/>
      </response>
      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="Hayne has failed me. Get me another commander... one less incompetent this time, please."/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
    <event>
      <condition type="startGame"/>
      <response type="disableMorale">
        <disable value="true"/>
      </response>
      <response type="disableControllers">
        <disable value="true"/>
      </response>
      <response type="highlight">
        <x value="10"/>
        <y value="6"/>
        <show value="true"/>
      </response>

	  <response type="unitDisable"><x value="10" /><y value="6" /><disable value="true"/></response>	  
	  
      <response type="scroll">
        <x value="10"/>
        <y value="6"/>
      </response>
      <response type="chat">
        <sender value="MAJOR MAYJOR"/>
        <message value="What is that thing?"/>
        <avatar value="mayjor"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="That, Major, is the War Machine. General Durand has ordered that we obtain its technology for the glory of the Akadian army."/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="MAJOR MAYJOR"/>
        <message value="How are we supposed to capture that? It's like a city! It's huge!"/>
        <avatar value="mayjor"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="Just watch me carefully and I'll show you how a true warrior gets the job done."/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="highlight">
        <x value="10"/>
        <y value="6"/>
        <show value="false"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="And so modest, too."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN ARGENT"/>
        <message value="Is he the new guy? Oh, he's dreamy."/>
        <avatar value="argent"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="Tucker! How nice of you to arrive in time for a crushing defeat. I was afraid you would simply spend all your time running from my awesome might."/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="MAJOR MAYJOR"/>
        <message value="Uncle says Tucker is dangerous."/>
        <avatar value="mayjor"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="Hush, Major. Watch and learn."/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="scroll">
        <x value="0"/>
        <y value="0"/>
      </response>
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1"/>
        <victory value="true"/>
      </condition>
      <response type="disableControllers">
        <disable value="true"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="Cowards!"/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="MAJOR MAYJOR"/>
        <message value="What just happened? Are they even allowed to do that? Weren't you supposed to be teaching me how to do something?"/>
        <avatar value="mayjor"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="They detonated the unit, rather than see it fall into our hands. Where are you Tucker, you coward?! Where did he go? Off hiding in some cave?"/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="MAJOR MAYJOR"/>
        <message value="I demand a do-over! DO-OVER!"/>
        <avatar value="mayjor"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="Major, I have a very important task for you."/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="MAJOR MAYJOR"/>
        <message value="Ooh! What is it?"/>
        <avatar value="mayjor"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="The engineers have quite a lot of work ahead of them sifting through the rubble for the parts they need. They can't be left unprotected."/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="MAJOR MAYJOR"/>
        <message value="But what are you going to do?"/>
        <avatar value="mayjor"/>
        <color value="FF0000FF"/>
      </response>
