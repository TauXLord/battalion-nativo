        <unit value="Hunter Support"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Corvette Fighter"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Battlecruiser"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="U-Boat"/>
      </response>
      <response type="disableAllUnits">
        <disable value="true"/>
        <player value="2"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Strike Commando"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Heavy Commando"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
