      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Scorpion Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Mortar Truck"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Rocket Truck"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Stealth Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Annihilator Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Condor Bomber"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Raptor Fighter"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Hunter Support"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Corvette Fighter"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Battlecruiser"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="U-Boat"/>
      </response>
	
	
	
	
	
	
	
	
      <response type="resources">
        <player value="2"/>
        <amount value="5000"/>
      </response>
      <response type="createTransportedUnit">
        <x value="7"/>
        <y value="8"/>
        <player value="1"/>
        <transportType value="Annihilator Tank"/>
        <transporterType value="Leviathan Barge"/>
      </response>
      <response type="createTransportedUnit">
        <x value="6"/>
        <y value="9"/>
        <player value="1"/>
        <transportType value="Flak Tank"/>
        <transporterType value="Leviathan Barge"/>
      </response>
      <response type="createTransportedUnit">
        <x value="6"/>
        <y value="9"/>
        <player value="1"/>
        <transportType value="Flak Tank"/>
        <transporterType value="Leviathan Barge"/>
      </response>
      <response type="chat">
        <sender value="MAJOR MAYJOR"/>
        <message value="Uncle Durand keeps trying to radio us. He wants to know how we're progressing on the return trip."/>
        <avatar value="mayjor"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="We have a battle to attend to."/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="MAJOR MAYJOR"/>
        <message value="But it's such a bad idea!"/>
        <avatar value="mayjor"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="Then you need to do your absolute best if you don't want to get blown up, won't you?"/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="MAJOR MAYJOR"/>
        <message value="I guess."/>
        <avatar value="mayjor"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="Focus the assault on overtaking the Federation resources. They'll overpower us with reinforcements if we cannot claim control. If we can shut down that factory, it's just a matter of time before Tucker falls before our superior weaponry."/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1"/>
        <victory value="true"/>
      </condition>
      <response type="disableControllers">
        <disable value="true"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="Do you see, Tucker? No one can defeat me. Not you, not your Dragoon friends. No one!"/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="And you still can't catch me. Not everyone is very good at finishing what they start. It's okay."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN ARGENT"/>
        <message value="Uh-oh! Bad habit!"/>
        <avatar value="argent"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="That's no good."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN ARGENT"/>
        <message value="Shall we head to our secret forest base now?"/>
        <avatar value="argent"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="After you, good sir."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="Fools! I will crush you once and for all!"/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
  </script>
</map>