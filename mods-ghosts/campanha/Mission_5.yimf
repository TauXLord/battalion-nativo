  <script>
    <event>
      <condition type="endGame">
        <player value="1"/>
        <victory value="false"/>
      </condition>
      <response type="disableControllers">
        <disable value="true"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN ARGENT"/>
        <message value="I thought he was supposed to be the big Akadian tough guy? Man, whatever to that."/>
        <avatar value="argent"/>
        <color value="FFFF0000"/>
      </response>
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
    <event>
      <condition type="startGame"/>
      <response type="disableMorale">
        <disable value="true"/>
      </response>
      <response type="disableControllers">
        <disable value="true"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN ARGENT"/>
        <message value="Back for more, eh?"/>
        <avatar value="argent"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="I defeated you before, and I will do so again."/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN ARGENT"/>
        <message value="I never was very good at keeping track of the score."/>
        <avatar value="argent"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="Will you surrender the War Machines to me, or do I have to beat you until you cry for your mother?"/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN ARGENT"/>
        <message value="Are you for real? Who talks like that?"/>
        <avatar value="argent"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="Who talks like that? I am the most decorated commander in Akadian history... for my age. They call me the Akadian Avenger, the Terror of the Battlefield, the Northern Federation Nemesis..."/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN ARGENT"/>
        <message value="Hey now. Let's not be too hasty about this battle thing. I was just... ummm... you have a... wonderful speaking voice."/>
        <avatar value="argent"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="If you want the War Machine, you'll have to come take it. Unless you're afraid you can't handle the firepower."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN ARGENT"/>
        <message value="...pssst... stop making him angry!"/>
        <avatar value="argent"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="We are going to crush you all. There will be parades in our honor! We'll be heroes! And you, Tucker, you'll be dead."/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1"/>
        <victory value="true"/>
      </condition>
      <response type="disableControllers">
        <disable value="true"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="You're good, Hayne. It's too bad you can't see the General for what he is."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="What do you know of the General? He is a hero and he crushed your forces after making a fool of you."/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="I'd love to stay and educate you on what we've learned about your General Durand since he betrayed us, but elaborate military plans call."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="Stand and fight, coward!"/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN ARGENT"/>
        <message value="Can't. We've got haircuts later."/>
        <avatar value="argent"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="MAJOR MAYJOR"/>
        <message value="Lieutenant! Uncle Durand is on comms. There's a vein popping out of his forehead."/>
        <avatar value="mayjor"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="It's time for us to begin basking in the glow of our glory, Major."/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="Hello, sir! We have defeated the Federation once again and the engineers should now have enough parts to reconstruct and produce the War Machine. Akadia forever!"/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="War Machine? Who cares about the War Machine anymore? We have something much more pressing to deal with, Lieutenant. The Dragoons have returned."/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="MAJOR MAYJOR"/>
        <message value="Dragons?!"/>
        <avatar value="mayjor"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="The Dragoons... all these years later. They've finally returned to finish what they started."/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="MAJOR MAYJOR"/>
        <message value="Scales and wings and claws and fire! We're doomed!"/>
        <avatar value="mayjor"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="Shut up, nephew! Clearly, the Dragoons want the chance to finally destroy the Akadian people. You must stop them."/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="I will, sir. I have a score to settle with the Dragoons. My father was killed during the raid that sparked off the Dragoon War."/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="If they have joined forces with Captain Tucker, this is a dangerous combination. We have no idea what sorts of weaponry that the Dragoons will be bringing with them."/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="Whatever they may have... it will not be enough."/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="MAJOR MAYJOR"/>
        <message value="What can we use to defeat dragons?! Unicorns! We'll ride unicorns into battle. Unicorns with laser missiles strapped to their backs!"/>
        <avatar value="mayjor"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="Mayjor, get a hold of yourself and  gather the forces. The Dragoons must be approaching over the Nithenian Sea. We strike at the Federation shipyards immediately!"/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
  </script>
</map>