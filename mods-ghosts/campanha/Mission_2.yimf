  <script>

    <event>
      <condition type="endGame">
        <player value="1" />
        <victory value="false" />
      </condition>
	
      <response type="disableControllers">
        <disable value="true" />
      </response>
	
      <response type="chat">
        <sender value="MAJOR MAYJOR" />
        <message value="Uncle told me you were the best! He lied to me." />
        <avatar value="mayjor" />
        <color value="FF0000FF" />
      </response>
      <response type="chat">
        <sender value="MAJOR MAYJOR" />
        <message value="Or maybe... maybe he meant that I'm the best! Wooo! I'm the best!" />
        <avatar value="mayjor" />
        <color value="FF0000FF" />
      </response>
	
      <response type="disableControllers">
        <disable value="false" />
      </response>
	
    </event>
	
    <event>
      <condition type="startGame" />
	  <response type="disableMorale"><disable value="true" /></response>
	
      <response type="disableControllers">
        <disable value="true" />
      </response>
	
	  <response type="chat">
        <sender value="MAJOR MAYJOR" />
        <message value="Sir! Reporting for duty!" />
        <avatar value="mayjor" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="Who are you?" />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="MAJOR MAYJOR" />
        <message value="Major Mayjor, sir! General Durand instructed that I am to report to you for personal tutelage!" />
        <avatar value="mayjor" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="Major Mayjor? Is this a prank? Am I getting punked?" />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="MAJOR MAYJOR" />
        <message value="I don't think so, sir. Did you want to be? Was that an order? Is that my first order?!" />
        <avatar value="mayjor" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="I always thought the General liked me." />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="MAJOR MAYJOR" />
        <message value="He must! I'm his favorite nephew!" />
        <avatar value="mayjor" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="Aren't you his only nephew?" />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="MAJOR MAYJOR" />
        <message value="Maybe." />
        <avatar value="mayjor" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="Major, this is a relatively small force. I want you to use the long-range Rocket Trucks supported by the Stealth Tanks. Just try not to destroy my beautiful tanks." />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="MAJOR MAYJOR" />
        <message value="No promises, sir!" />
        <avatar value="mayjor" />
        <color value="FF0000FF" />
      </response>
	
      <response type="disableControllers">
        <disable value="false" />
      </response>
	
	</event>
	
	
	<event>
      <condition type="endGame">
        <player value="1" />
        <victory value="true" />
      </condition>
	
      <response type="disableControllers">
        <disable value="true" />
      </response>
	
	  <response type="chat">
        <sender value="MAJOR MAYJOR" />
        <message value="I can't believe I did it! I won! I won everything! I'm a legend! Uncle Durand will be so proud!" />
        <avatar value="mayjor" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="Let's not be hasty. I am the master tactician and commander here. I have guided you to victory." />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="MAJOR MAYJOR" />
        <message value="But you didn't DO anything." />
        <avatar value="mayjor" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="It's leadership by osmosis. You benefit because I'm here. Very complicated. You wouldn't understand." />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="MAJOR MAYJOR" />
        <message value="Whatever. I'm the best! Everyone will love me now!" />
        <avatar value="mayjor" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="That glory is mine!" />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="MAJOR MAYJOR" />
        <message value="I touched it last." />
        <avatar value="mayjor" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="Ah! What is this? A Federation contingent up ahead? Soon, this new Federation toy will be the latest weapon in the my...erm... in the Akadian arsenal." />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>
	
      <response type="disableControllers">
        <disable value="false" />
      </response>
	
	</event>
	
    <empty />
  </script>
</map>