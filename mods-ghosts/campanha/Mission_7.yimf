  <script>

    <event>
      <condition type="endGame">
        <player value="1" />
        <victory value="false" />
      </condition>
	
      <response type="disableControllers">
        <disable value="true" />
      </response>
	
      <response type="chat">
        <sender value="GENERAL DURAND" />
        <message value="Isn't there anyone competent other than me in this army?" />
        <avatar value="evil_durand" />
        <color value="FF0000FF" />
      </response>
	
      <response type="disableControllers">
        <disable value="false" />
      </response>
	
    </event>
	
	
	<event>
      <condition type="startGame" />
	  <response type="disableMorale"><disable value="true" /></response>
	
      <response type="disableControllers">
        <disable value="true" />
      </response>
	
	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="This report is worrying." />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="MAJOR MAYJOR" />
        <message value="What does it say?" />
        <avatar value="mayjor" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="The Jammer Truck is an electronics disruption unit. The infiltration team reports that the truck will prevent aerial units from flying within its range and it will even counteract the cloaking ability of our stealth tanks. This is disastrous!" />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="MAJOR MAYJOR" />
        <message value="Won't this be a great time for you to show me what a wonderful soldier you are? I even brought a notepad so I could take notes!" />
        <avatar value="mayjor" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="How about I show you the back of my hand?" />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="MAJOR MAYJOR" />
        <message value="But... I did bring a notepad! It's right here! I drew a picture of you riding a tank on it!" />
        <avatar value="mayjor" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="Focus, Major. This is a major naval center for the Federation. We must annihilate all Federation presence here. They cannot be allowed to continue bringing Dragoon forces onto the mainland. Strike fast! No prisoners!" />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>
	
      <response type="disableControllers">
        <disable value="false" />
      </response>
	
    </event>
	
	<event>
      <condition type="endGame">
        <player value="1" />
        <victory value="true" />
      </condition>
	
      <response type="disableControllers">
        <disable value="true" />
      </response>
	
	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="Victory! With this naval center demolished, the Federation's ability to bring in further Dragoon support is crippled. It should be a simple matter for the vast Akadian army to clean up the remnants. I must contact the General to report our success." />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>
	
      <response type="chat">
        <sender value="GENERAL DURAND" />
        <message value="Yes, Lieutenant?" />
        <avatar value="evil_durand" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="The Federation shipyards are no more, sir. The flow of Dragoons should now be a trickle. The crisis is averted once again by my magnificence." />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>
	
      <response type="chat">
        <sender value="GENERAL DURAND" />
        <message value="Return to rejoin the main force. Then we will sweep across the land and purge our enemies from it." />
        <avatar value="evil_durand" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="Yes, sir. We'll return right away." />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="CAPTAIN ARGENT" />
        <message value="Buck, buck, buck, bakaw!" />
        <avatar value="argent" />
        <color value="FFFF0000" />
      </response>
	
	  <response type="chat">
        <sender value="CAPTAIN TUCKER" />
        <message value="What are you doing Argent?" />
        <avatar value="tucker" />
        <color value="FFFF0000" />
      </response>

	  <response type="chat">
        <sender value="CAPTAIN ARGENT" />
        <message value="That's my chicken sound. No good?" />
        <avatar value="argent" />
        <color value="FFFF0000" />
      </response>
	
	  <response type="chat">
        <sender value="CAPTAIN TUCKER" />
        <message value="Leaving so soon, Hayne? Probably for the best. I'll be sort of a legend in the Federation for constantly outwitting and escaping from the Akadian Bumbler, Lieutenant Hayne." />
        <avatar value="tucker" />
        <color value="FFFF0000" />
      </response>
	
	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="Ridiculous! I am the finest military mind of this generation! I have beaten your forces again and again. You are no match for me." />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="CAPTAIN TUCKER" />
        <message value="And here you are, returning home like a good little boy, tail between your legs." />
        <avatar value="tucker" />
        <color value="FFFF0000" />
      </response>
	
	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="I have my orders!" />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>

	  <response type="chat">
        <sender value="CAPTAIN TUCKER" />
        <message value="Exactly. Durand knows that you can't hack it out here anymore. He knows I've been saving my best forces and he knows that you can't measure up." />
        <avatar value="tucker" />
        <color value="FFFF0000" />
      </response>
	
	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="Mayjor, gather the troops. We advance on the position of Captain Tucker's radio broadcast." />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="MAJOR MAYJOR" />
        <message value="But it's an island fortress! And it's a trap. He wants you to disobey orders. Even I know that, and I'm an idiot!" />
        <avatar value="mayjor" />
        <color value="FF0000FF" />
      </response>
	
	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="I don't care. The world will know that no one can defeat me." />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>
	
      <response type="disableControllers">
        <disable value="false" />
      </response>
	
	</event>
	
	

    <event>
      <condition type="startGame" />
	

 <response type="disableAllUnits">
        <disable value="true"/>
        <player value="1"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Strike Commando"/>
      </response>
      <response type="enableUnit">
