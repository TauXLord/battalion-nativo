  </tile>
  <tile c="17" r="1">
    <layer reference="54" depth="0"/>
  </tile>
  <tile c="17" r="2">
    <layer reference="12" depth="0"/>
  </tile>
  <tile c="17" r="3">
    <layer reference="0" depth="0"/>
  </tile>
  <tile c="17" r="4">
    <layer reference="0" depth="0"/>
  </tile>
  <tile c="17" r="5">
    <layer reference="0" depth="0"/>
  </tile>
  <tile c="17" r="6">
    <layer reference="0" depth="0"/>
  </tile>
  <tile c="17" r="7">
    <layer reference="0" depth="0"/>
  </tile>
  <tile c="17" r="8">
    <layer reference="1" depth="0"/>
  </tile>
  <tile c="17" r="9">
    <layer reference="9" depth="0"/>
  </tile>
  <script>
    <event>
      <condition type="endGame">
        <player value="1"/>
        <victory value="false"/>
      </condition>
      <response type="disableControllers">
        <disable value="true"/>
      </response>
	
      <response type="damageUnit">
        <x value="16"/>
        <y value="1"/>
        <amount value="100"/>
      </response>
	
      <response type="chat">
        <sender value="MAJOR MAYJOR"/>
        <message value="I could understand losing to actual dragons. Those guys are cool. These guys should have been a piece of cake. Mmmmmm... cake."/>
        <avatar value="mayjor"/>
        <color value="FF0000FF"/>
      </response>
		
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
    <event>
      <condition type="startGame">
        <satisfied value="true"/>
      </condition>
	
      <response type="disableControllers">
        <disable value="true"/>
      </response>
	
 <response type="disableAllUnits">
        <disable value="true"/>
        <player value="1"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Strike Commando"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Heavy Commando"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Flak Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Scorpion Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Mortar Truck"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Rocket Truck"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Stealth Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Annihilator Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Condor Bomber"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Raptor Fighter"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Hunter Support"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Corvette Fighter"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Battlecruiser"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="U-Boat"/>
      </response>
      <response type="disableAllUnits">
        <disable value="true"/>
        <player value="2"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Strike Commando"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Heavy Commando"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Flak Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Scorpion Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Mortar Truck"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Rocket Truck"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Stealth Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Annihilator Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Condor Bomber"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Raptor Fighter"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Hunter Support"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Corvette Fighter"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Battlecruiser"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="U-Boat"/>
      </response>
	
	
	
      <response type="createTransportedUnit">
        <x value="0"/>
        <y value="0"/>
        <player value="1"/>
        <transportType value="Scorpion Tank"/>
        <transporterType value="Leviathan Barge"/>
      </response>
      <response type="createTransportedUnit">
        <x value="0"/>
        <y value="1"/>
        <player value="1"/>
        <transportType value="Scorpion Tank"/>
        <transporterType value="Leviathan Barge"/>
      </response>
      <response type="createTransportedUnit">
        <x value="0"/>
        <y value="6"/>
        <player value="1"/>
        <transportType value="Scorpion Tank"/>
        <transporterType value="Leviathan Barge"/>
      </response>
      <response type="createTransportedUnit">
        <x value="0"/>
        <y value="7"/>
        <player value="1"/>
        <transportType value="Scorpion Tank"/>
        <transporterType value="Leviathan Barge"/>
      </response>
      <response type="createTransportedUnit">
        <x value="1"/>
        <y value="7"/>
        <player value="1"/>
        <transportType value="Scorpion Tank"/>
        <transporterType value="Leviathan Barge"/>
      </response>
      <response type="createTransportedUnit">
        <x value="1"/>
        <y value="0"/>
        <player value="1"/>
        <transportType value="Stealth Tank"/>
        <transporterType value="Leviathan Barge"/>
      </response>
      <response type="createTransportedUnit">
        <x value="1"/>
        <y value="1"/>
        <player value="1"/>
        <transportType value="Stealth Tank"/>
        <transporterType value="Leviathan Barge"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="The War Machine is ready. Now we'll use the Federation's own weapon against them. It's a shame the Dragoons had to come all this way just to be dashed against the shore."/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="MAJOR MAYJOR"/>
        <message value="I don't know how to swim."/>
        <avatar value="mayjor"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="Then you'll just have to make sure your ship doesn't sink, won't you?"/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="How nice of you to come greet our guests, Lieutenant."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="Tucker. Of course. But it's not very polite of you to invite a guest over just so they can receive a severe beating."/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="I don't recall inviting YOU anywhere."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="MAJOR MAYJOR"/>
        <message value="Oh snap!"/>
        <avatar value="mayjor"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="Man the ships, Major. I want you to storm across that water and seize these shores. I'm tired of hearing Tucker and his crony mock us in spite of their failures."/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1"/>
        <victory value="true"/>
      </condition>
      <response type="disableControllers">
        <disable value="true"/>
      </response>
      <response type="chat">
        <sender value="MAJOR MAYJOR"/>
        <message value="So, those weren't dragons, those were Dragoons. I feel cheated."/>
        <avatar value="mayjor"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="What was that strange unit?"/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="GENERAL USUL"/>
        <message value="That was the Jammer Truck."/>
        <avatar value="usul"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="Were you planning on joining this fight anytime soon, Dragoon?"/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="GENERAL USUL"/>
        <message value="Not before having a chance to study my enemy."/>
        <avatar value="usul"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="And what have learned, watching from your little truck?"/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="GENERAL USUL"/>
        <message value="That you are skillful, aggressive and headstrong, just as Captain Tucker has said."/>
        <avatar value="usul"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="You should leave here, Dragoon. There is nothing but destruction for you here."/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="GENERAL USUL"/>
        <message value="Not so. We have come here for our vengeance."/>
        <avatar value="usul"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="Vengeance?! You started the Dragoon War with your raids on Akadia. We were allies!"/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="GENERAL USUL"/>
        <message value="How interesting. The victors truly do write the history books."/>
        <avatar value="usul"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="And soon they will write about how the great Lieutenant Hayne drove the Dragoon menace from Akadian shores once and for all!"/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="GENERAL USUL"/>
        <message value="We will meet again, Lieutenant."/>
        <avatar value="usul"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="Arrogant old man! We need to know what that Jammer Truck is capable of! Send out an infiltration team, I want a report of its capabilities immediately!"/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="2"/>
        <victory value="false"/>
      </condition>
      <response type="disableControllers">
        <disable value="true"/>
      </response>
      <response type="scroll">
        <x value="16"/>
        <y value="1"/>
      </response>
      <response type="highlight">
        <x value="16"/>
        <y value="1"/>
        <show value="true"/>
      </response>
      <response type="removeUnit">
        <x value="16"/>
        <y value="1"/>
        <fadeOut value="true"/>
      </response>
      <response type="highlight">
        <x value="16"/>
        <y value="1"/>
        <show value="false"/>
      </response>
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
  </script>
</map>