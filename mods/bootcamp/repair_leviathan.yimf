  <script>
    <event>
      <condition type="startGame" />
	  <response type="disableMorale"><disable value="true" /></response>
      <response type="disableControllers">
        <disable value="true" />
      </response>
      <response type="disableUnit">
        <disable value="true" />
        <controller value="0" />
        <unit value="Annihilator Tank" />
      </response>
      <response type="disableUnit">
        <disable value="true" />
        <controller value="0" />
        <unit value="Stealth Tank" />
      </response>
      <response type="disableUnit">
        <disable value="true" />
        <controller value="0" />
        <unit value="Rocket Truck" />
      </response>
      <response type="damageUnit">
        <x value="0" />
        <y value="3" />
        <amount value="15" />
      </response>
      <response type="damageUnit">
        <x value="1" />
        <y value="3" />
        <amount value="25" />
      </response>
      <response type="damageUnit">
        <x value="2" />
        <y value="2" />
        <amount value="13" />
      </response>
      <response type="damageUnit">
        <x value="3" />
        <y value="1" />
        <amount value="5" />
      </response>
      <response type="damageUnit">
        <x value="4" />
        <y value="0" />
        <amount value="11" />
      </response>
      <response type="damageUnit">
        <x value="5" />
        <y value="0" />
        <amount value="7" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="In some scenarios you'll be joining your troops mid-battle." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Here your forces have had to retreat across a channel after being pummeled by the enemy troops." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Rally your troops by repairing them from the safety of the remote island." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Repairing hurts the morale of your troops, so use it wisely on the frontlines." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="The repair will complete at the start of your next turn and will repair up to 25% of the health of the unit. You can repair repeatedly until the unit is at 100% health." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="If an enemy attacks you before the repair completes, you will lose the repair will fail and the unit will be unable to counterattack." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Once your army is back in top shape, call a fleet of Leviathans and take the island." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="You can order repairs and Leviathan pickups from the special actions menu. Click twice on a unit to bring up its special actions menu." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Good luck, soldier." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="disableControllers">
        <disable value="false" />
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1" />
        <victory value="false" />
      </condition>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Make sure you have repaired your units completely before mounting your assault." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Try to land all your Leviathans at the same time. It will reduce the effectiveness of the enemy's initial attack." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="This is a harder mission, for sure, but we need to prepare you for the real thing. Let's try again." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1" />
        <victory value="true" />
      </condition>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Congratulations, soldier. It looks like you are almost ready to graduate from boot camp!" />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
    </event>
  </script>
</map>