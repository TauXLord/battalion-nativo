  <script>
    <event>
      <condition type="startGame" />
	  <response type="disableMorale"><disable value="true" /></response>
      <response type="disableControllers">
        <disable value="true" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Well, recruit, let's get down to business." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="highlight">
        <x value="3" />
        <y value="3" />
        <show value="true" />
      </response>
      <response type="highlight">
        <x value="4" />
        <y value="2" />
        <show value="true" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="You've been granted control of two Scorpion Tanks." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="highlight">
        <x value="3" />
        <y value="3" />
        <show value="false" />
      </response>
      <response type="highlight">
        <x value="4" />
        <y value="2" />
        <show value="false" />
      </response>
      <response type="highlight">
        <x value="4" />
        <y value="5" />
        <show value="true" />
      </response>
      <response type="highlight">
        <x value="5" />
        <y value="5" />
        <show value="true" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Your task is to defeat the two enemy Flak Tanks." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="The Flak Tank's weapon is weak against armored targets like the Scorpion Tank so you should have no problem dealing with these guys." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="highlight">
        <x value="4" />
        <y value="5" />
        <show value="false" />
      </response>
      <response type="highlight">
        <x value="5" />
        <y value="5" />
        <show value="false" />
      </response>
      <response type="highlight">
        <x value="4" />
        <y value="4" />
        <show value="true" />
      </response>
      <response type="highlight">
        <x value="5" />
        <y value="4" />
        <show value="true" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="If you want to minimize the damage you take, we suggest you attack from these locations. The dense terrain will absorb some of the damage incurred during the enemy's counter attack." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="highlight">
        <x value="4" />
        <y value="4" />
        <show value="false" />
      </response>
      <response type="highlight">
        <x value="5" />
        <y value="4" />
        <show value="false" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Good luck, soldier!" />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="disableControllers">
        <disable value="False" />
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1" />
        <victory value="false" />
      </condition>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Um.. I guess we need to try that again." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1" />
        <victory value="true" />
      </condition>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Great work, soldier. It is time to move on to your next lesson." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
    </event>
  </script>
</map>