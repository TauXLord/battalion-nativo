  <script>
    <event>
      <condition type="startGame" />
	  <response type="disableMorale"><disable value="true" /></response>
      <response type="disableControllers">
        <disable value="true" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="As an officer in the Northern Federation, you will often find yourself in control of ground, air and sea forces." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="In this scenario you are being tasked with eliminating the enemy naval fleet and ground forces using a combination of your air force and ground troops." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="highlight">
        <x value="7" />
        <y value="5" />
        <show value="true" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="The Condor Bomber is one of the most powerful units in the game. It can do massive damage to ground and sea targets." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="highlight">
        <x value="7" />
        <y value="5" />
        <show value="false" />
      </response>
      <response type="highlight">
        <x value="7" />
        <y value="2" />
        <show value="true" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Beware the enemy Rocket Truck. It is capable of firing on air, sea and ground targets and it has an impressive range, though it tends to be more effective against heavily armored targets." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="highlight">
        <x value="7" />
        <y value="2" />
        <show value="false" />
      </response>
      <response type="highlight">
        <x value="2" />
        <y value="4" />
        <show value="true" />
      </response>
      <response type="highlight">
        <x value="2" />
        <y value="6" />
        <show value="true" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="The enemy Battlecruisers have a longer attack range than any other unit on the battlefield. Luckily, its guns cannot fire on your air units." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="highlight">
        <x value="2" />
        <y value="4" />
        <show value="false" />
      </response>
      <response type="highlight">
        <x value="2" />
        <y value="6" />
        <show value="false" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Remember to review the important tactical information that appears in the recon panel when you click on a unit or terrain. Good luck soldier!" />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="disableControllers">
        <disable value="False" />
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1" />
        <victory value="false" />
      </condition>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="You can win this battle without your ground forces." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Focus on eliminating the Rocket Truck and Flak Tank. If even one of your air units survives the encounter, the enemy will be unable to stop you." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Ready to give it another go?" />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1" />
        <victory value="true" />
      </condition>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Generally speaking, you will be commanding multi-disciplinary forces. Picking the right mix of air, sea and ground forces is the key to strategic victory. Let's move on to the next lesson." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
    </event>
  </script>
</map>