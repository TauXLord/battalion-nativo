  <script>
    <event>
      <condition type="startGame" />
	  <response type="disableMorale"><disable value="true" /></response>
      <response type="disableControllers">
        <disable value="true" />
      </response>
      <response type="disableAllUnits">
        <disable value="true" />
        <controller value="0" />
      </response>
      <response type="enableUnit">
        <enable value="true" />
        <controller value="0" />
        <unit value="Strike Commando" />
      </response>
      <response type="enableUnit">
        <enable value="true" />
        <controller value="0" />
        <unit value="Heavy Commando" />
      </response>
      <response type="enableUnit">
        <enable value="true" />
        <controller value="0" />
        <unit value="Flak Tank" />
      </response>
      <response type="enableUnit">
        <enable value="true" />
        <controller value="0" />
        <unit value="Scorpion Tank" />
      </response>
      <response type="enableUnit">
        <enable value="true" />
        <controller value="0" />
        <unit value="Mortar Truck" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="When the enemy outnumbers you, you must use chokepoints and the terrain to level the playing field." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="highlight">
        <x value="7" />
        <y value="3" />
        <show value="true" />
      </response>
      <response type="highlight">
        <x value="8" />
        <y value="2" />
        <show value="true" />
      </response>
      <response type="highlight">
        <x value="5" />
        <y value="3" />
        <show value="true" />
      </response>
      <response type="highlight">
        <x value="6" />
        <y value="1" />
        <show value="true" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="I suggest you move two Scorpion Tanks into these positions to create a choke point." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="highlight">
        <x value="7" />
        <y value="3" />
        <show value="false" />
      </response>
      <response type="highlight">
        <x value="8" />
        <y value="2" />
        <show value="false" />
      </response>
      <response type="highlight">
        <x value="5" />
        <y value="3" />
        <show value="false" />
      </response>
      <response type="highlight">
        <x value="6" />
        <y value="1" />
        <show value="false" />
      </response>
      <response type="highlight">
        <x value="7" />
        <y value="2" />
        <show value="true" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="This Rocket Truck's ranged attack can soften up the enemy units from safely behind your choke point." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="highlight">
        <x value="7" />
        <y value="2" />
        <show value="false" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Just remember that ranged units like the Rocket Truck cannot move and attack in the same turn. Begin!" />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="disableControllers">
        <disable value="False" />
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1" />
        <victory value="false" />
      </condition>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Creating a defensible choke point at the start of this mission is key to surviving long enough to establish an army." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Remember to keep your Rocket Truck behind the choke point so that it can provide long range tactical support." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Sometimes you just need a little bit of recon. I understand. Let's give it another go." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1" />
        <victory value="true" />
      </condition>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Leveraging a strategic choke point can be the difference between success and defeat in many battles. Support your unranged units with long range artillery units like the Rocket Truck." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
    </event>
  </script>
</map>