  <script>
    <event>
      <condition type="startGame" />
	  <response type="disableMorale"><disable value="true" /></response>
      <response type="disableControllers">
        <disable value="true" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="In some scenarios, you may not have enough resources in your War Machine to mount an effective assault on your enemy." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="To defeat your enemy in these situations, you will have to extract resources from the various Ore Deposits that litter a level." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="highlight">
        <x value="4" />
        <y value="0" />
        <show value="true" />
      </response>
      <response type="highlight">
        <x value="3" />
        <y value="1" />
        <show value="true" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Move your War Machine to an Ore Deposit and activate the Extract ability from the special actions menu to extract resources from the Ore Deposit." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="There are two kinds of Ore Deposit on this level." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="highlight">
        <x value="3" />
        <y value="1" />
        <show value="false" />
      </response>
      <response type="highlight">
        <x value="1" />
        <y value="1" />
        <show value="true" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="These are Enriched Ore Deposits that can be extracted twice for double the total resources." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="highlight">
        <x value="4" />
        <y value="0" />
        <show value="false" />
      </response>
      <response type="highlight">
        <x value="1" />
        <y value="1" />
        <show value="false" />
      </response>
      <response type="highlight">
        <x value="3" />
        <y value="1" />
        <show value="true" />
      </response>
      <response type="highlight">
        <x value="6" />
        <y value="0" />
        <show value="true" />
      </response>
      <response type="highlight">
        <x value="6" />
        <y value="4" />
        <show value="true" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Regular Ore Deposits can only be extracted once." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="highlight">
        <x value="3" />
        <y value="1" />
        <show value="false" />
      </response>
      <response type="highlight">
        <x value="6" />
        <y value="0" />
        <show value="false" />
      </response>
      <response type="highlight">
        <x value="6" />
        <y value="4" />
        <show value="false" />
      </response>
      <response type="highlight">
        <x value="3" />
        <y value="5" />
        <show value="true" />
      </response>
      <response type="highlight">
        <x value="5" />
        <y value="6" />
        <show value="true" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="The enemy is fielding a new unit on this level called a Jammer Truck." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="The Jammer Truck is a support unit with no offensive capabilities but it is an essential component of most armies." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Clicking on a Jammer Truck will reveal its jamming zone. The jamming zone cannot be entered by aircraft and it will decloak stealth units." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="highlight">
        <x value="3" />
        <y value="5" />
        <show value="false" />
      </response>
      <response type="highlight">
        <x value="5" />
        <y value="6" />
        <show value="false" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Remember that the Blockades will buy you some time while you establish your army." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Engage!" />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="disableControllers">
        <disable value="False" />
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1" />
        <victory value="false" />
      </condition>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="You probably can't save the exposed War Machine, but you should still see if you can slow down the enemy's advance on your protected War Machine." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Remember to use your War Machine to extract resources from the Ore Deposits." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1" />
        <victory value="true" />
      </condition>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="I bet that was stressful. Nice job! We've only got one last lesson to go through." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
    </event>
  </script>
</map>