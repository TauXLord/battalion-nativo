  <script>
    <event>
      <condition type="endGame">
        <player value="1" />
        <victory value="false" />
      </condition>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Keep your War Machines protected behind the Blockades while you build an army to take on the enemy." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1" />
        <victory value="true" />
      </condition>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Well done, soldier. On with your next lesson." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
    </event>
    <event>
      <condition type="startGame" />
	  <response type="disableMorale"><disable value="true" /></response>
      <response type="disableControllers">
        <disable value="true" />
      </response>
      <response type="highlight">
        <x value="1" />
        <y value="1" />
        <show value="true" />
      </response>
      <response type="highlight">
        <x value="8" />
        <y value="1" />
        <show value="true" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="On some missions, you'll be placed in command of the mighty War Machine." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="highlight">
        <x value="1" />
        <y value="1" />
        <show value="false" />
      </response>
      <response type="highlight">
        <x value="8" />
        <y value="1" />
        <show value="false" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="Use the War Machine's 'Build' action to create an army and defeat your enemies. Clicking the War Machine twice will open the action menu." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="highlight">
        <x value="2" />
        <y value="3" />
        <show value="true" />
      </response>
      <response type="highlight">
        <x value="2" />
        <y value="4" />
        <show value="true" />
      </response>
      <response type="highlight">
        <x value="7" />
        <y value="3" />
        <show value="true" />
      </response>
      <response type="highlight">
        <x value="7" />
        <y value="4" />
        <show value="true" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="These Blockades will protect your War Machines for a few turns." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL" />
        <message value="The enemy has to destroy them before he can reach your War Machines." />
        <avatar value="pearl" />
        <color value="FFFF0000" />
      </response>
      <response type="highlight">
        <x value="2" />
        <y value="3" />
        <show value="false" />
      </response>
      <response type="highlight">
        <x value="2" />
        <y value="4" />
        <show value="false" />
      </response>
      <response type="highlight">
        <x value="7" />
        <y value="3" />
        <show value="false" />
      </response>
      <response type="highlight">
        <x value="7" />
        <y value="4" />
        <show value="false" />
      </response>
      <response type="disableControllers">
        <disable value="false" />
      </response>
    </event>
  </script>
</map>