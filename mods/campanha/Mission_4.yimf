  <script>
    <event>
      <condition type="startGame"/>
      <response type="disableMorale">
        <disable value="true"/>
      </response>
      <response type="unitDisable">
        <x value="9"/>
        <y value="9"/>
        <disable value="true"/>
      </response>
      <response type="disableAllUnits">
        <disable value="true"/>
        <player value="2"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Spider Tank"/>
      </response>
      <response type="disableControllers">
        <disable value="true"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="Everyone, be on your guard!"/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Once we pass these mountains, we will be enclosed within Akadian territory. Retreat will be tricky, if not impossible."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="Victory has always been our only option, Captain. This vengeance is our destiny as a people."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Our early scouting parties into this area were all annihilated without broadcasting back any data. There's something here, but we have no idea what."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="All that awaits us here is victory over an Akadian enemy. Nothing more."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Have you met Lieutenant Hayne, by chance? He's Akadian, but I get the impression you two might get along."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1"/>
        <victory value="false"/>
      </condition>
      <response type="disableControllers">
        <disable value="true"/>
      </response>
      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="No one can stand against the spider tank. I love a good ambush."/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1"/>
        <victory value="true"/>
      </condition>
      <response type="disableControllers">
        <disable value="true"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="I hate spider tanks. They give me the willies. Anyone else?"/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="I do not fear anything that I can defeat in battle."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Okay. Guess that's just me then."/>
        <avatar value="tucker"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="AKADIAN SOLDIER"/>
        <message value="Sir. The spider tank outpost has been defeated, sir."/>
        <avatar value="Akadian_3"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="The spider tanks performed admirably. Too bad they were not enough to stop them cold. Prepare the War Machines. Have the spies reported back in?"/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="AKADIAN SOLDIER"/>
        <message value="They have sir. All missions report success."/>
        <avatar value="Akadian_3"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="Excellent. I'm waiting for you Tucker, old friend. Don't take too long..."/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
  </script>
</map>