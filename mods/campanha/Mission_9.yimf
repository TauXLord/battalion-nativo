  <tile c="11" r="9">
    <layer reference="24" depth="0" />
  </tile>
  <tile c="12" r="9">
    <layer reference="24" depth="0" />
  </tile>
  <tile c="13" r="9">
    <layer reference="30" depth="0" />
  </tile>
  <tile c="14" r="9">
    <layer reference="4" depth="0" />
    <layer reference="38" depth="2" />
  </tile>
  <tile c="15" r="9">
    <layer reference="4" depth="0" />
  </tile>
  <tile c="16" r="9">
    <layer reference="4" depth="0" />
    <layer reference="21" depth="2" />
  </tile>
  <tile c="17" r="9">
    <layer reference="4" depth="0" />
  </tile>
  <script>

    <event>
      <condition type="startGame" />
	  <response type="disableMorale">
		<disable value="true" />
		</response>
	
      <response type="disableControllers">
        <disable value="true" />
      </response>
	

<response type="disableAllUnits">
        <disable value="true"/>
        <player value="1"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Strike Commando"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Heavy Commando"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Flak Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Scorpion Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Mortar Truck"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Rocket Truck"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Stealth Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Annihilator Tank"/>
      </response>
	
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Condor Bomber"/>
      </response>

      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Raptor Fighter"/>
      </response>

	
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Lancer Tank"/>
      </response>
	
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Vulture Drone"/>
      </response>
	
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Hunter Support"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Intrepid"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Corvette Fighter"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Battlecruiser"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="U-Boat"/>
      </response>
	
	
<response type="disableAllUnits">
        <disable value="true"/>
        <player value="2"/>
      </response>
	
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Spider Tank"/>
      </response>
	
	
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Strike Commando"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Heavy Commando"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Flak Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Scorpion Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Mortar Truck"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Rocket Truck"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Stealth Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Annihilator Tank"/>
      </response>
	
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Condor Bomber"/>
      </response>

      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Raptor Fighter"/>
      </response>

      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Hunter Support"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Intrepid"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Corvette Fighter"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Battlecruiser"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="U-Boat"/>
      </response>
	
	
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="This is madness."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>

	  <response type="chat">
        <sender value="CAPTAIN ARGENT" />
        <message value="No. This... is... SP—AR-" />
        <avatar value="argent" />
        <color value="FFFF0000" />
      </response>

      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Not now Argent."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>

	  <response type="chat">
        <sender value="CAPTAIN ARGENT" />
        <message value="Oh, come on, man!" />
        <avatar value="argent" />
        <color value="FFFF0000" />
      </response>

      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="We have no choice but to advance. If we retreat now, Durand will have time to regain his power and to escape. We will never be free of him unless we strike."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>

      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="We'll never be able to breach these defenses. There are simply too many, far more than our scouts had estimated."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>

      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="Then leave. I do not fear death in the service of my nation."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>

      <response type="chat">
        <sender value="CAPTAIN ARGENT"/>
        <message value="Don't be too hasty guys. Look who I found lurking outside our base. It's my old buddy!"/>
        <avatar value="argent"/>
        <color value="FF00FF00"/>
      </response>

	  	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="I wasn't lurking. I came here to help. There is a route. A mountain pass across the lake. It's poorly defended. The terrain there won't support the heavier units. I can take you there." />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>

	  <response type="chat">
        <sender value="CAPTAIN ARGENT" />
        <message value="I don't trust him. I say we ice this greaseball." />
        <avatar value="argent" />
        <color value="FFFF0000" />
      </response>

      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Take it easy Argent. I think he's really here to help."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>

	  	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="He has to be stopped. I don't... I don't think I can do it alone. I want you to help me. My father died in those strikes on Akadian bases that Durand ordered. I have to help put him to rest." />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>

      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="We move immediately."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>

	  <response type="chat">
        <sender value="CAPTAIN ARGENT" />
        <message value="You trust him?" />
        <avatar value="argent" />
        <color value="FFFF0000" />
      </response>

      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="You see madness and betrayal behind his eyes, but I see the devotion of a man consumed by his cause. Our vengeance will be his vengeance."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
	
	
      <response type="disableControllers">
        <disable value="false" />
      </response>
	
    </event>
	

	
	
    <event>
      <condition type="endGame">
        <player value="1" />
        <victory value="true" />
      </condition>
	
      <response type="disableControllers">
        <disable value="true" />
      </response>

      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="We cannot fail here, Tucker. This battle means too much to our people. If you or Argent do not feel up to the challenge that faces us, I cannot allow you to join us."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>

      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="We're all ready. Durand has to be stopped."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>

	  <response type="chat">
        <sender value="CAPTAIN ARGENT" />
        <message value="I dunno. I AM pretty tired." />
        <avatar value="argent" />
        <color value="FFFF0000" />
      </response>

      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="You don't get a vote."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>

	  	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="Father, I will avenge you." />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>

      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="It is settled then. At dawn, we take Durand's fortress. Prepare yourselves."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
	
	
      <response type="disableControllers">
        <disable value="false" />
      </response>
	
    </event>
	
		<event>
	
      <condition type="endGame">
        <player value="1" />
        <victory value="false" />
      </condition>

      <response type="disableControllers">
        <disable value="true" />
      </response>

	
      <response type="chat">
        <sender value="GENERAL DURAND" />
        <message value="Oooooh. So close. And yet, so very far away. Maybe next time, team." />
        <avatar value="evil_durand" />
        <color value="FF0000FF" />
      </response>
	
      <response type="disableControllers">
        <disable value="false" />
      </response>
	
    </event>
	

	
  </script>
</map>