    <layer reference="0" depth="0" />
    <layer reference="5" depth="2" />
  </tile>
  <script>

    <event>
      <condition type="startGame" />
	  <response type="disableMorale">
		<disable value="true" />
		</response>
	
      <response type="disableControllers">
        <disable value="true" />
      </response>
	
<response type="disableAllUnits">
        <disable value="true"/>
        <player value="1"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Strike Commando"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Heavy Commando"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Flak Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Scorpion Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Mortar Truck"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Rocket Truck"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Stealth Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Annihilator Tank"/>
      </response>
	
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Condor Bomber"/>
      </response>

      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Raptor Fighter"/>
      </response>

	
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Lancer Tank"/>
      </response>
	
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Vulture Drone"/>
      </response>
	
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Hunter Support"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Intrepid"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Corvette Fighter"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Battlecruiser"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="U-Boat"/>
      </response>
	
	
<response type="disableAllUnits">
        <disable value="true"/>
        <player value="2"/>
      </response>
	
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Spider Tank"/>
      </response>
	
	
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Strike Commando"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Heavy Commando"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Flak Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Scorpion Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Mortar Truck"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Rocket Truck"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Stealth Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Annihilator Tank"/>
      </response>
	
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Condor Bomber"/>
      </response>

      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Raptor Fighter"/>
      </response>

      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Hunter Support"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Intrepid"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Corvette Fighter"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Battlecruiser"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="U-Boat"/>
      </response>
	
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="Incoming aircraft! It is your comrade Argent."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>

      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Argent! Good to see you safe and sound."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>

	  <response type="chat">
        <sender value="CAPTAIN ARGENT" />
        <message value="*gasp* *pant* Hayne's on his way. *wheeze* He vanished after I showed him the secret orders. He gathered troops to strike Durand and just left. I got here as fast as I could." />
        <avatar value="argent" />
        <color value="FFFF0000" />
      </response>

      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="Your information is old. Now prepare for the coming assault."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>

	  <response type="chat">
        <sender value="CAPTAIN ARGENT" />
        <message value="Is he... is this a joke? I'm not going to lie, I'm very out of shape and I did a lot of running to get to this plane, which broke down and I had to fix it with my bare hands. You ever fixed a plane without tools, smart guy?" />
        <avatar value="argent" />
        <color value="FFFF0000" />
      </response>

      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Sorry, Argent. Hayne showed up already, but we defeated him and he's run off again. As you can see, though, Durand has quite a large ambush waiting for us. So welcome to the party."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>

	  <response type="chat">
        <sender value="CAPTAIN ARGENT" />
        <message value="Man, I hate you guys." />
        <avatar value="argent" />
        <color value="FFFF0000" />
      </response>
	
	  <response type="chat">
        <sender value="CAPTAIN ARGENT" />
        <message value="But hey, for a new chapter in the saga of how much I rule, I put together a new prototype on my journey back. Check out the blue prints for my new flier, the Vulture Drone. I know what you're going to say. I think I'm sexy and intelligent, too." />
        <avatar value="argent" />
        <color value="FFFF0000" />
      </response>
	
      <response type="disableControllers">
        <disable value="false" />
      </response>
	
    </event>
	

	
	
    <event>
      <condition type="endGame">
        <player value="1" />
        <victory value="true" />
      </condition>
	
      <response type="disableControllers">
        <disable value="true" />
      </response>
	
	
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="Durand hides himself again."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>

      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="He's preparing a final assault. I know him. It's his style."/>
        <avatar value="tucker"/>
        <color value="FF00FF00"/>
      </response>
	
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="Good. Soon we will crush Durand and restore our place on this continent."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>

      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Peace will be a welcome change."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>

	  <response type="chat">
        <sender value="CAPTAIN ARGENT" />
        <message value="And then maybe I can take that vacation I keep getting promised." />
        <avatar value="argent" />
        <color value="FFFF0000" />
      </response>

      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="Yes, then you can exercise some of that flab to be more useful in future ambushes."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
	
	
      <response type="disableControllers">
        <disable value="false" />
      </response>
	
    </event>
	
		<event>
	
      <condition type="endGame">
        <player value="1" />
        <victory value="false" />
      </condition>

      <response type="disableControllers">
        <disable value="true" />
      </response>

      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="Our troops were not strong enough. What did we fail to instill in them? What lessons did we not teach? It does not matter now, though. We can never return home."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
	
      <response type="disableControllers">
        <disable value="false" />
      </response>
	
    </event>
	

	
  </script>
</map>