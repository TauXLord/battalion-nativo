  <script>

    <event>
      <condition type="startGame" />
	  <response type="disableMorale">
		<disable value="true" />
		</response>
	
      <response type="disableControllers">
        <disable value="true" />
      </response>
	
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="It appears that I may have been wrong about your comrade."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>    

      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Argent? What do you mean?"/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>	

      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="Those ships downriver, they are commanded by Lieutenant Hayne. Since he is here and Argent is not, I can only assume that your comrade was defeated."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>

      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="There has to be some other explanation. Argent is a good soldier... and I'm sure General Pearl would have saved his sorry butt if he got into too much trouble."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>	

      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="Hayne's troops movements are erratic. Indecisive. He is either a brilliant tactician, or..."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>	

	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="Tucker! In my way again! And the Dragoons! You're all trying to steal it from me. Well you can't! I'll be the one to kill him. ME! Only me! Victory must be mine. I need to have it." />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>	  

      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="... totally deranged."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>	

      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Survey says: bonkers."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>	


      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="Hayne's units are within range. Attack, all units! We must contend with Hayne before we can handle Durand."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
	  
	  
	
      <response type="disableControllers">
        <disable value="false" />
      </response>
	
    </event>
	

	
	
    <event>
      <condition type="endGame">
        <player value="1" />
        <victory value="true" />
      </condition>
	
      <response type="disableControllers">
        <disable value="true" />
      </response>
	
	  	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="Defeated again! I can't get my revenge this way. I must have it, though. I'll find it somewhere else. But where? Where! It's time to go now. Time to vanish." />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>	  

      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="It's not just me, right? His brain is broken?"/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>		

      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="It would seem that we are not his final objective. He appears to be after General Durand."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>

      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="The only thing I can think that would make a loyal soldier turn like that is something that destroys his faith in his commander."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>	

      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="It would seem that your Captain Argent accomplished his mission after all."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>	

      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="He must have shown Hayne the orders we uncovered of Durand calling for secret strikes on Akadian territory. On his own people."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>	

      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="The attacks that started the Dragoon War, the war that drove my people from our homes at the hands of enraged Akadians. All an elaborate lie."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>

      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Let's keep moving. I'd like to be very far away from Lieutenant Nutbar before he decides we're in his way again."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>	
	  
	
      <response type="disableControllers">
        <disable value="false" />
      </response>
	
    </event>
	
		<event>
	
      <condition type="endGame">
        <player value="1" />
        <victory value="false" />
      </condition>

      <response type="disableControllers">
        <disable value="true" />
      </response>

	  	  <response type="chat">
        <sender value="LIEUTENANT HAYNE" />
        <message value="Yes! Victory. Durand will be next. Tucker and the Dragoons cannot steal my vengeance from me anymore." />
        <avatar value="hayne" />
        <color value="FF0000FF" />
      </response>	  
	
	  
      <response type="disableControllers">
        <disable value="false" />
      </response>
	
    </event>
	

	
  </script>
</map>