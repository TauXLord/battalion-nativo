  <script>
    <event>
      <condition type="startGame">
        <satisfied value="true"/>
      </condition>
      <response type="disableControllers">
        <disable value="true"/>
      </response>
	
      <response type="disableMorale">
        <disable value="true"/>
      </response>

	
	  <response type="createTransportedUnit">
        <x value="8"/>
        <y value="10"/>
        <player value="1"/>
        <transportType value="Scorpion Tank"/>
        <transporterType value="Leviathan Barge"/>
      </response>
      <response type="createTransportedUnit">
        <x value="9"/>
        <y value="11"/>
        <player value="1"/>
