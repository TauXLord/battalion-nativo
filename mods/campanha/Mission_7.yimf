        <player value="1"/>
        <transportType value="Flak Tank"/>
        <transporterType value="Leviathan Barge"/>
      </response>
	
	
	
	

<response type="disableAllUnits">
        <disable value="true"/>
        <player value="1"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Strike Commando"/>
      </response>
      <response type="enableUnit">
