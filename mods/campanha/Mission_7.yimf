      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="Welcome esteemed guests! Long time, no see! As you may observe, I have arranged for quite the welcoming committee. Hospitality is important, in spite of our differences."/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="Be careful. This must be another of Durand's traps. I do not think this is a real welcoming committee."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Do you have sarcasm back home, Yurik?"/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="We must land quickly and prevent our units from being taken in the water. The priority is to secure our War Machine units and the ore deposits needed to fuel them. Move quickly!"/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1"/>
        <victory value="true"/>
      </condition>
      <response type="disableControllers">
        <disable value="true"/>
      </response>
      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="I have plenty more gifts waiting for you if you insist on continuing to march to your own deaths."/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Your era is done, Durand. We have come to finish things."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="Your people will soon know who it was that started the wars that have turned Akadia into a wasteland. When they learn that your power-mongering has led to their downfall, there will be nothing left for you."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="If my defeat is so inevitable, then why bother with your fighting? Let the Akadian people police this issue. Why waste more of your lives? Because I assure you, death is coming for you."/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Speaking of impending doom, we met Lieutenant Hayne on our way. He was crazed, muttering something about needing to be the one that killed you. Isn't that strange for your vaunted hero?"/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="Lies. Hayne is a loyal Akadian. He would never desert his army."/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Funny, I imagine he said the same thing about you right before we showed him your secret orders commanding Akadian troops to fire on their own people, all so you could start a war to pretend to be a hero."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="I think I'll kill you first, Tucker."/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="You can try."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1"/>
        <victory value="false"/>
      </condition>
      <response type="disableControllers">
        <disable value="true"/>
      </response>
      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="The first sign of a real battle and they crumble. Typical. Now, back to ruling the world..."/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
  </script>
</map>