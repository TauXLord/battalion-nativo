  <script>
    <event>
      <condition type="startGame" />
	  <response type="disableMorale">
		<disable value="true" />
	  </response>
	
      <response type="disableControllers">
        <disable value="true"/>
      </response>
	
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Are you ready for this, Commander Yurik?"/>
        <avatar value="tucker"/>
        <color value="FF00FF00"/>
      </response>
	
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="This will be a difficult task for my Dragoons, Captain Tucker."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
	
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="For a Dragoon force? You guys are legends. The finest warriors the world has ever seen. You live for the honor of combat."/>
        <avatar value="tucker"/>
        <color value="FF00FF00"/>
      </response>

      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="That is the problem. This is a meaningless diversion, not a suitable enemy."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>

      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="These troops are outliers of a fearsome enemy force. If we don't deal with them accordingly, we run the risk of endangering our own forces."/>
        <avatar value="tucker"/>
        <color value="FF00FF00"/>
      </response>

      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="Fine. The faster we dispatch these distractions, the more quickly we will be able to stop Durand, and perhaps free his people from their delusions."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>

      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="You Dragoons are almost surreal. Guaranteed victory against your most bitter enemy, and you're still concerned about the honor of the battlefield."/>
        <avatar value="tucker"/>
        <color value="FF00FF00"/>
      </response>

      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="Soon we will see a return for our people to the homeland. I would not have it tarnished by any manner of shame."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
	
	
      <response type="disableControllers">
        <disable value="false"/>
      </response>
	
    </event>
	
	
	
    <event>
      <condition type="endGame">
        <player value="1" />
        <victory value="false" />
      </condition>

      <response type="disableControllers">
        <disable value="true" />
      </response>
	
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="So... I guess you guys are sort of rusty on the whole war thing, right?"/>
        <avatar value="tucker"/>
        <color value="FF00FF00"/>
      </response>
	
      <response type="disableControllers">
        <disable value="false" />
      </response>
	
    </event>
	
 <event>
      <condition type="endGame">
        <player value="1" />
        <victory value="true" />
      </condition>
	
      <response type="disableControllers">
        <disable value="true" />
      </response>
	
	
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Impressive as always, Commander."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>

      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="I cannot celebrate such an uneven victory. They could never have defeated us."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>

      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="The closer we get to the Akadian center, the more dangerous this assault will become. I have a feeling Durand isn't out of tricks yet."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>

      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="My Dragoons have a few surprises for him as well. He has not faced us in a very long time, and we have learned our lessons well."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>

      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="I'm glad you're on our team, Yurik. To be frank, you can be a pretty intimidating guy."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>

      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="Thank you. Years of practice."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
	
	
      <response type="disableControllers">
        <disable value="false" />
      </response>
	
    </event>
	
	
  </script>
</map>