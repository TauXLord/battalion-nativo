  </tile>
  <script>
    <event>
      <event>
        <condition type="startGame"/>
        <response type="disableMorale">
          <disable value="true"/>
        </response>
        <response type="disableControllers">
          <disable value="true"/>
        </response>
        <response type="chat">
          <sender value="COMMANDER YURIK"/>
          <message value="Again! He cannot call this honorable combat."/>
          <avatar value="yurik"/>
          <color value="FF00FF00"/>
        </response>
        <response type="chat">
          <sender value="CAPTAIN TUCKER"/>
          <message value="I don't think he'd even try. Durand isn't really concerned with all the niceties you seem to practice."/>
          <avatar value="tucker"/>
          <color value="FF00FF00"/>
        </response>
        <response type="chat">
          <sender value="COMMANDER YURIK"/>
          <message value="He sends his men to die! Our rockets will destroy them as they beat themselves against the barricades that defend us."/>
          <avatar value="yurik"/>
          <color value="FF00FF00"/>
        </response>
        <response type="chat">
          <sender value="CAPTAIN TUCKER"/>
          <message value="The Akadians are skilled in the mountains. Most importantly, they're hard to hit. It might not be as easy as you think."/>
          <avatar value="tucker"/>
          <color value="FF00FF00"/>
        </response>
        <response type="chat">
          <sender value="COMMANDER YURIK"/>
          <message value="But how can they defeat us while we stay behind the barricades. The range of our rockets is immense."/>
          <avatar value="yurik"/>
          <color value="FF00FF00"/>
        </response>
        <response type="chat">
          <sender value="CAPTAIN TUCKER"/>
          <message value="Our rockets can't hit his troops while they are protected by those canyons. Your HUD will show an icon above his units when they are in cover."/>
          <avatar value="tucker"/>
          <color value="FF00FF00"/>
        </response>
        <response type="chat">
          <sender value="COMMANDER YURIK"/>
          <message value="I will monitor those icons and try not to be so presumptuous."/>
          <avatar value="yurik"/>
          <color value="FF00FF00"/>
        </response>
        <response type="chat">
          <sender value="CAPTAIN TUCKER"/>
          <message value="You're just going to have to work on some patience for awhile, Yurik."/>
          <avatar value="tucker"/>
          <color value="FF00FF00"/>
        </response>
        <response type="disableControllers">
          <disable value="false"/>
        </response>
      </event>
      <event>
        <condition type="endGame">
          <player value="1"/>
          <victory value="true"/>
        </condition>
        <response type="disableControllers">
          <disable value="true"/>
        </response>
        <response type="chat">
          <sender value="COMMANDER YURIK"/>
          <message value="At last! We must move quickly, men! Durand will slow us down at every turn. We must move swiftly while we can!"/>
          <avatar value="yurik"/>
          <color value="FF00FF00"/>
        </response>
        <response type="chat">
          <sender value="CAPTAIN TUCKER"/>
          <message value="Keep your eyes open! Don't forget how dangerous Durand is everyone. We need to keep pushing, but we can't get sloppy."/>
          <avatar value="tucker"/>
          <color value="FF00FF00"/>
        </response>
        <response type="chat">
          <sender value="COMMANDER YURIK"/>
          <message value="He has betrayed his people and my own. Started two wars, caused countless deaths. Because of him, my children have never seen the land of my birth."/>
          <avatar value="yurik"/>
          <color value="FF00FF00"/>
        </response>
        <response type="chat">
          <sender value="AKADIAN SOLDIER"/>
          <message value="Sir, the invading forces have breached the borderlands."/>
          <avatar value="Akadian_3"/>
          <color value="FF0000FF"/>
        </response>
        <response type="chat">
          <sender value="GENERAL DURAND"/>
          <message value="Yes. And I'll bet they're feeling very confident. Assured of their victory. We'll let them believe things will be this easy for a bit longer. Then we will teach them what war is."/>
          <avatar value="evil_durand"/>
          <color value="FF0000FF"/>
        </response>
        <response type="disableControllers">
          <disable value="false"/>
        </response>
      </event>
      <condition type="endGame">
        <player value="1"/>
        <victory value="false"/>
      </condition>
      <response type="disableControllers">
        <disable value="true"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Man, I don't know. I expected better from you guys. Seriously."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
  </script>
</map>