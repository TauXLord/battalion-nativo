    <layer reference="7" depth="0"/>
  </tile>
  <tile c="15" r="14">
    <layer reference="7" depth="0"/>
  </tile>
  <script>
    <event>
      <condition type="startGame"/>
      <response type="disableMorale">
        <disable value="true"/>
      </response>
      <response type="disableControllers">
        <disable value="true"/>
      </response>
      <response type="disableAllUnits">
        <disable value="true"/>
        <player value="1"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Strike Commando"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Heavy Commando"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Flak Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Scorpion Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Mortar Truck"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Rocket Truck"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Stealth Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Annihilator Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Condor Bomber"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Raptor Fighter"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Lancer Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Vulture Drone"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Hunter Support"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Intrepid"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Corvette Fighter"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Battlecruiser"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="U-Boat"/>
      </response>
      <response type="disableAllUnits">
        <disable value="true"/>
        <player value="2"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Spider Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Strike Commando"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Heavy Commando"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Flak Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Scorpion Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Mortar Truck"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Rocket Truck"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Stealth Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Annihilator Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Condor Bomber"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Raptor Fighter"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Hunter Support"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Intrepid"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Corvette Fighter"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Battlecruiser"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="U-Boat"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Lancer Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Vulture Drone"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="We are here."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Hayne's secret pathway did its job. All that's left is the final stronghold for Durand."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="We've got to end this."/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="How is it that you are silent, Argent?"/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN ARGENT"/>
        <message value="This has been a long time coming for all of us. I'll be able to laugh about this one once it's all over."/>
        <avatar value="argent"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="Hayne. So it's true? You're a traitor. I did not expect you all so soon, which means he must have led you through our private pathways."/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="LIEUTENANT HAYNE"/>
        <message value="Traitor? Ironic, coming from you."/>
        <avatar value="hayne"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="I never thought I'd have to kill you, Hayne. I almost feel bad about it."/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="Your time is over, Durand. Today will begin a new era, and the Dragoons will return to our home."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="Are you sure about that?"/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
	
      <response type="scroll">
        <x value="15"/>
        <y value="15"/>
      </response>
	
      <response type="chat">
        <sender value="CAPTAIN ARGENT"/>
        <message value="Lancers and Vultures! What the heck?! I just made that like a week ago and you already stole it. Dang, man. That's cold."/>
        <avatar value="argent"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="My spies are busy little bees. What can I say?"/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Enough. We're done with your tricks Durand. We're going to put an end to you."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
	
      <response type="scroll">
        <x value="0"/>
        <y value="0"/>
      </response>
	
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1"/>
        <victory value="true"/>
      </condition>
      <response type="disableControllers">
        <disable value="true"/>
      </response>
      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="I suppose you think you've won."/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="Our victory is clear. None of your defenses remain."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN ARGENT"/>
        <message value="In your FACE."/>
        <avatar value="argent"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Your people will know what you've done Durand. They'll know they've spent years living in a wasteland due to the aftermath of a war you started. They will never accept you again."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="Just execute me if there is nothing left for me."/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="You will go to prison as punishment for your crimes. Everyone will see what becomes of men like you."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="Exactly. As long as I breathe, you will never have won. Never."/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN ARGENT"/>
        <message value="Get his sorry butt out of here! I'm tired of hearing him yap. You got schooled, chump! Schooled hard!"/>
        <avatar value="argent"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL"/>
        <message value="Did I miss the whole party?"/>
        <avatar value="pearl"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="We did not have a party. Today we had a glorious battle."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="No sarcasm."/>
        <avatar value="tucker"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL"/>
        <message value="I always forget they're no good at that. Well, I'm proud of you boys. You did a fine job."/>
        <avatar value="pearl"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN ARGENT"/>
        <message value="I don't know about you guys, but when I feel proud of someone, I like to shower them with cash. Lots and lots of cash. I'll be right over here when you're ready to start throwing stacks of money at me."/>
        <avatar value="argent"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Welcome home, Yurik. It will be nice to have our old neighbors back where they belong."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="You have done a brave thing, Tucker. You have risked your life in our cause. This makes us brothers."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN ARGENT"/>
        <message value="Still waiting for my cash shower..."/>
        <avatar value="argent"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="I'm pretty sure there are some Northern Fed parades waiting for you to be Grand Marshall of, Argent? Will you accept fame and an adoring nation instead of cash?"/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN ARGENT"/>
        <message value="I could be persuaded. Will there be groupies?"/>
        <avatar value="argent"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="GENERAL PEARL"/>
        <message value="Get out of here, all of you! Go! Go be heroes! You've earned it."/>
        <avatar value="pearl"/>
        <color value="FFFF0000"/>
      </response>
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1"/>
        <victory value="false"/>
      </condition>
      <response type="disableControllers">
        <disable value="true"/>
      </response>
      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="Could there have been any other outcome? I hate seeing someone waste their time the way those fools did."/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
  </script>
</map>