        <unit value="Heavy Commando"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Flak Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Scorpion Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
