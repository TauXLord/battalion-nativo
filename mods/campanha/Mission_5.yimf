        <unit value="Stealth Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Annihilator Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Hunter Support"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Intrepid"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Corvette Fighter"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="Battlecruiser"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="1"/>
        <unit value="U-Boat"/>
      </response>
      <response type="disableAllUnits">
        <disable value="true"/>
        <player value="2"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Flak Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Scorpion Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Mortar Truck"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Rocket Truck"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Stealth Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Annihilator Tank"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Hunter Support"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Intrepid"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Corvette Fighter"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="Battlecruiser"/>
      </response>
      <response type="enableUnit">
        <enable value="true"/>
        <player value="2"/>
        <unit value="U-Boat"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="It's as if this land was built for war."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="I know what you mean. Everything's designed to make it hard to get in or out."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="There are natural chokepoints everywhere. Assaulting that War Machine could be a strategic nightmare."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="It's too bad they don't know that we also have a few tricks up our sleeves."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="Would you like to command the Lancers, Tucker?"/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="But those are your secret weapon."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="There is no greater thrill than to observe a great weapon wielded with skill. I am curious to see how a man known for his sharp and efficient strikes would make use of a machine like the Lancer."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="Remember, Tucker. The penetrating shot of the Lancer's attack will damage two units if they are foolish enough to line themselves up in front of it."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="I'll try to make the Dragoons proud."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1"/>
        <victory value="true"/>
      </condition>
      <response type="disableControllers">
        <disable value="true"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="A fine victory, Tucker. Well done."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Things seem to be going according to battle plans. It makes me nervous. It can't be this easy."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="Durand is a coward at heart. He has depended on lies and subterfuge to wreak his havoc. He never would have defeated the Dragoon nation without an unprovoked and surprise invasion."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Then let's keep this convoy moving! We've got a job to do."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="Good day, gentlemen. Those Lancers are quite useful."/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="Durand! Face your judgment."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="At your hands? No. I don't think so. No Argent? That's too bad. I guess he wasn't good enough without his pal Tucker to save him all the time. I bet that will weigh on the conscience."/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="Hayne is surely no match for Federation forces. He was brash and thoughtless, no match for Captain Argent's wit."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="GENERAL DURAND"/>
        <message value="And yet, he's not here. Very interesting. I should leave you time to mourn, Tucker. See you soon."/>
        <avatar value="evil_durand"/>
        <color value="FF0000FF"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="Do not worry, Tucker. He will answer for his crimes, we will see to it. And I am sure your comrade is safe."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1"/>
        <victory value="false"/>
      </condition>
      <response type="disableControllers">
        <disable value="true"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="I am fairly certain that my young ones back at home, fresh off of the playground, would drive a Lancer better than you have just done, Tucker."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
  </script>
</map>