  <script>
    <event>
      <condition type="startGame"/>
      <response type="disableMorale">
        <disable value="true"/>
      </response>
      <response type="disableControllers">
        <disable value="true"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="Finally, a battle a warrior can take pride in."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Air forces! Does this mean I'll finally get to see what those toys of yours can do?"/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="The Jammer Truck is no toy, Tucker."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Always serious, huh?"/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="I was raised that way."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="The Jammer Truck is a valuable piece of the Dragoon Army's defensive capabilities."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="Enemy aircraft will not be able to enter any airspace in the Jammer's range and stealth units will be revealed if they try to travel through it."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Sounds pretty awesome. I guess let's get to this."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="Yes. A true battle, at last."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1"/>
        <victory value="false"/>
      </condition>
      <response type="disableControllers">
        <disable value="true"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="My first chance at a real battle against the Akadians and I have failed. My shame is immeasurable."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="disableControllers">
        <disable value="false"/>
      </response>
    </event>
    <event>
      <condition type="endGame">
        <player value="1"/>
        <victory value="true"/>
      </condition>
      <response type="disableControllers">
        <disable value="true"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Seeing all those planes go down in flames... kind of reminds me of Argent. I hope he's okay."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="He is a capable warrior. He will be fine. I am confident he has dispatched Lieutenant Hayne."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="I'm not sure I would go that far."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="You are not confident in your comrade's abilities?"/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="He's a fine pilot. He's not really very... well... he's just so Argent, you know?"/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="I am afraid I do not know."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
      </response>
      <response type="chat">
        <sender value="CAPTAIN TUCKER"/>
        <message value="Let's just say that there is a lot of whining when he is around."/>
        <avatar value="tucker"/>
        <color value="FFFF0000"/>
      </response>
      <response type="chat">
        <sender value="COMMANDER YURIK"/>
        <message value="There is no whining among the Dragoons."/>
        <avatar value="yurik"/>
        <color value="FF00FF00"/>
